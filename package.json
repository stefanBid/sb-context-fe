{
  "name": "sb-context-nuxt",
  "private": true,
  "type": "module",
  "description": "Development tooling for the sb-context-nuxt Claude Code plugin (tests only: the plugin itself has no runtime dependencies).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:cli": "node --test \"tests/cli/**/*.test.mjs\"",
    "test:contract": "node --test \"tests/contract/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"scripts/**\" --test-coverage-include=\"skills/**\" \"tests/**/*.test.mjs\"",
    "test:coverage:lcov": "node --test --experimental-test-coverage --test-coverage-include=\"scripts/**\" --test-coverage-include=\"skills/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"tests/**/*.test.mjs\"",
    "validate": "claude plugin validate . --strict && claude plugin validate .claude-plugin/plugin.json --strict && claude plugin validate skills --strict"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  }
}
