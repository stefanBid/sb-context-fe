{
  "name": "sb-context-fe",
  "private": true,
  "type": "module",
  "description": "Development tooling for the sb-context-fe Claude Code plugins (tests only: the plugins themselves have no runtime dependencies).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:cli": "node --test \"tests/cli/**/*.test.mjs\"",
    "test:contract": "node --test \"tests/contract/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"core/**\" --test-coverage-include=\"plugins/**\" --test-coverage-exclude=\"plugins/*/core/**\" \"tests/**/*.test.mjs\"",
    "test:coverage:lcov": "node --test --experimental-test-coverage --test-coverage-include=\"core/**\" --test-coverage-include=\"plugins/**\" --test-coverage-exclude=\"plugins/*/core/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"tests/**/*.test.mjs\"",
    "sync-core": "node scripts/sync-core.mjs",
    "validate": "claude plugin validate . --strict && for p in plugins/*/; do claude plugin validate \"$p\" --strict || exit 1; if [ -d \"$p/skills\" ]; then claude plugin validate \"$p/skills\" --strict || exit 1; fi; done"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  }
}
